<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>AirPass – QR Boarding Pass in Seconds</title>
    <meta
      name="description"
      content="Fill in your flight details, pay $1 securely with Stripe, and get a personal QR code boarding pass sent straight to your email."
    />
    <meta
      name="keywords"
      content="AirPass, QR code, boarding pass, flight, airline pass, Stripe"
    />
    <meta name="author" content="AirPass" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#ff7a01" />
    <meta name="color-scheme" content="light" />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='4' y='4' width='56' height='56' rx='12' fill='%23ff7a01' stroke='%23111' stroke-width='5'/%3E%3Cpath d='M14 34 L50 22 L40 46 L33 37 Z' fill='%23fff' stroke='%23111' stroke-width='4' stroke-linejoin='round'/%3E%3C/svg%3E"
    />

    <!-- Open Graph (link previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AirPass" />
    <meta property="og:title" content="AirPass – QR Boarding Pass in Seconds" />
    <meta
      property="og:description"
      content="Pay $1 securely and get your personal QR code boarding pass by email."
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta
      name="twitter:title"
      content="AirPass – QR Boarding Pass in Seconds"
    />
    <meta
      name="twitter:description"
      content="Pay $1 securely and get your personal QR code boarding pass by email."
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink: #111;
        --paper: #ffeec9;
        --orange: #ff7a01;
        --yellow: #ffd93d;
        --white: #fff;
        --border: 3px solid var(--ink);
        --shadow: 6px 6px 0 var(--ink);
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Poppins', sans-serif;
        color: var(--ink);
        background-color: var(--paper);
        background-image: radial-gradient(var(--ink) 1px, transparent 1px);
        background-size: 22px 22px;
        min-height: 100vh;
      }

      .wrap {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px 60px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
        align-items: center;
        min-height: 100vh;
      }

      /* ---------- Left: hero ---------- */
      .hero {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        align-self: flex-start;
        background: var(--white);
        border: var(--border);
        box-shadow: 4px 4px 0 var(--ink);
        padding: 8px 16px;
        border-radius: 10px;
        font-weight: 900;
        font-size: 20px;
        letter-spacing: 0.5px;
      }
      .brand img {
        height: 36px;
        width: auto;
        display: block;
      }

      .headline {
        font-size: clamp(34px, 5vw, 56px);
        font-weight: 900;
        line-height: 1.05;
        text-transform: uppercase;
      }
      .headline span {
        background: var(--orange);
        border: var(--border);
        box-shadow: 4px 4px 0 var(--ink);
        padding: 0 10px;
        display: inline-block;
        transform: rotate(-2deg);
        margin-top: 6px;
      }

      .sticker {
        align-self: flex-start;
        background: var(--yellow);
        border: var(--border);
        box-shadow: 4px 4px 0 var(--ink);
        padding: 8px 14px;
        border-radius: 999px;
        font-weight: 700;
        font-size: 14px;
        transform: rotate(2deg);
      }

      .hero-img {
        border: var(--border);
        box-shadow: var(--shadow);
        border-radius: 14px;
        overflow: hidden;
        background: var(--orange);
      }
      .hero-img svg {
        display: block;
        width: 100%;
        height: auto;
      }

      /* ---------- Right: ticket form ---------- */
      .ticket {
        background: var(--white);
        border: var(--border);
        border-right-width: 6px;
        border-bottom-width: 6px;
        box-shadow: 10px 10px 0 var(--ink);
        border-radius: 16px;
        overflow: hidden;
      }
      .ticket-head {
        background: var(--orange);
        border-bottom: var(--border);
        padding: 16px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
      }
      .ticket-head .price {
        background: var(--yellow);
        border: var(--border);
        padding: 2px 12px;
        border-radius: 8px;
        box-shadow: 3px 3px 0 var(--ink);
      }
      .ticket-body {
        padding: 24px 22px 26px;
      }

      .field {
        margin-bottom: 16px;
      }
      .field label {
        display: block;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 6px;
      }
      .field input {
        width: 100%;
        font: inherit;
        font-weight: 500;
        padding: 12px 14px;
        background: var(--paper);
        color: var(--ink);
        border: var(--border);
        border-radius: 10px;
        outline: none;
        transition:
          transform 0.12s ease,
          box-shadow 0.12s ease,
          background 0.12s ease;
      }
      .field input::placeholder {
        color: #8a7a55;
        font-weight: 400;
      }
      .field input:focus {
        background: var(--yellow);
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--ink);
      }

      .row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
      }

      .divider {
        border: none;
        border-top: 3px dashed var(--ink);
        margin: 6px 0 20px;
      }

      .btn-pay {
        width: 100%;
        font: inherit;
        font-size: 18px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 16px;
        background: var(--orange);
        color: var(--ink);
        border: var(--border);
        border-radius: 12px;
        box-shadow: var(--shadow);
        cursor: pointer;
        transition:
          transform 0.1s ease,
          box-shadow 0.1s ease,
          background 0.1s ease;
      }
      .btn-pay:hover {
        background: var(--yellow);
        transform: translate(-2px, -2px);
        box-shadow: 8px 8px 0 var(--ink);
      }
      .btn-pay:active {
        transform: translate(6px, 6px);
        box-shadow: 0 0 0 var(--ink);
      }

      .note {
        margin-top: 14px;
        font-size: 12px;
        font-weight: 600;
        text-align: center;
      }

      /* ---------- Responsive ---------- */
      @media (max-width: 900px) {
        .wrap {
          grid-template-columns: 1fr;
          gap: 32px;
          min-height: auto;
          padding-top: 28px;
        }
        .hero-img {
          display: none;
        }
      }
      @media (max-width: 480px) {
        .row {
          grid-template-columns: 1fr;
          gap: 0;
        }
        .ticket {
          box-shadow: 6px 6px 0 var(--ink);
        }
      }
    </style>
  </head>

  <body>
    <main class="wrap">
      <!-- Left -->
      <section class="hero">
        <div class="brand">
          <img src="images/logo.png" alt="AirPass logo" />
          <span>AirPass</span>
        </div>

        <h1 class="headline">
          Easy to remember,
          <span>evokes “airline pass.”</span>
        </h1>

        <div class="sticker">⚡ QR code lands in your inbox in seconds</div>

        <div class="hero-img">
          <svg
            viewBox="0 0 560 380"
            xmlns="http://www.w3.org/2000/svg"
            role="img"
            aria-label="Plane and QR boarding pass illustration"
          >
            <g
              stroke="#111"
              stroke-width="4"
              stroke-linejoin="round"
              stroke-linecap="round"
            >
              <!-- sky -->
              <rect
                x="0"
                y="0"
                width="560"
                height="380"
                fill="#ff7a01"
                stroke="none"
              />
              <!-- grid lines -->
              <g stroke="#111" stroke-opacity=".15" stroke-width="2">
                <path
                  d="M0 95H560M0 190H560M0 285H560M140 0V380M280 0V380M420 0V380"
                />
              </g>

              <!-- sun -->
              <circle cx="455" cy="85" r="46" fill="#ffd93d" />

              <!-- clouds -->
              <g fill="#fff">
                <path
                  d="M40 120h110a24 24 0 0 0-6-46 34 34 0 0 0-62-8 28 28 0 0 0-42 54z"
                />
                <path
                  d="M330 345h160a22 22 0 0 0-4-42 30 30 0 0 0-56-6 26 26 0 0 0-100 48z"
                />
              </g>

              <!-- flight path -->
              <path
                d="M40 330C120 250 170 300 230 215S330 120 400 135"
                fill="none"
                stroke-dasharray="4 14"
                stroke-width="5"
              />

              <!-- plane -->
              <g transform="translate(80 60) rotate(-10)">
                <polygon points="62,8 112,8 84,-46 54,-46" fill="#ffd93d" />
                <polygon points="8,6 40,6 18,-28 0,-28" fill="#ffd93d" />
                <path
                  d="M0 24Q0 2 30 2H140Q184 2 196 24Q184 46 140 46H30Q0 46 0 24Z"
                  fill="#fff"
                />
                <circle cx="62" cy="24" r="6" fill="#ffd93d" />
                <circle cx="86" cy="24" r="6" fill="#ffd93d" />
                <circle cx="110" cy="24" r="6" fill="#ffd93d" />
                <circle cx="150" cy="22" r="7" fill="#111" />
                <polygon points="62,40 112,40 84,96 54,96" fill="#ffd93d" />
              </g>

              <!-- boarding pass -->
              <g transform="translate(250 175) rotate(-5)">
                <rect
                  x="6"
                  y="8"
                  width="250"
                  height="150"
                  rx="12"
                  fill="#111"
                  stroke="none"
                />
                <rect
                  x="0"
                  y="0"
                  width="250"
                  height="150"
                  rx="12"
                  fill="#fff"
                />
                <path
                  d="M0 12a12 12 0 0 1 12-12H238a12 12 0 0 1 12 12V36H0z"
                  fill="#111"
                />
                <text
                  x="16"
                  y="26"
                  font-family="Poppins, sans-serif"
                  font-weight="900"
                  font-size="14"
                  fill="#ffd93d"
                  stroke="none"
                  letter-spacing="1.5"
                >
                  BOARDING PASS
                </text>

                <!-- QR -->
                <rect
                  x="16"
                  y="52"
                  width="86"
                  height="86"
                  fill="#ffeec9"
                  stroke-width="3"
                />
                <g fill="#111" stroke="none">
                  <rect x="22" y="58" width="24" height="24" />
                  <rect x="27" y="63" width="14" height="14" fill="#ffeec9" />
                  <rect x="31" y="67" width="6" height="6" />
                  <rect x="72" y="58" width="24" height="24" />
                  <rect x="77" y="63" width="14" height="14" fill="#ffeec9" />
                  <rect x="81" y="67" width="6" height="6" />
                  <rect x="22" y="108" width="24" height="24" />
                  <rect x="27" y="113" width="14" height="14" fill="#ffeec9" />
                  <rect x="31" y="117" width="6" height="6" />
                  <rect x="52" y="58" width="8" height="8" />
                  <rect x="60" y="66" width="8" height="8" />
                  <rect x="52" y="82" width="8" height="8" />
                  <rect x="68" y="82" width="8" height="8" />
                  <rect x="84" y="86" width="8" height="8" />
                  <rect x="22" y="90" width="8" height="8" />
                  <rect x="36" y="94" width="8" height="8" />
                  <rect x="52" y="98" width="8" height="8" />
                  <rect x="76" y="98" width="8" height="8" />
                  <rect x="60" y="108" width="8" height="8" />
                  <rect x="84" y="108" width="8" height="8" />
                  <rect x="68" y="118" width="8" height="8" />
                  <rect x="52" y="124" width="8" height="8" />
                  <rect x="84" y="122" width="8" height="8" />
                </g>

                <!-- details -->
                <g stroke="none" font-family="Poppins, sans-serif" fill="#111">
                  <text
                    x="120"
                    y="62"
                    font-size="9"
                    font-weight="700"
                    fill="#555"
                  >
                    FROM
                  </text>
                  <text x="120" y="80" font-size="20" font-weight="900">
                    JFK
                  </text>
                  <text
                    x="180"
                    y="62"
                    font-size="9"
                    font-weight="700"
                    fill="#555"
                  >
                    TO
                  </text>
                  <text x="180" y="80" font-size="20" font-weight="900">
                    LAX
                  </text>
                </g>
                <path d="M120 94H236" stroke-width="3" stroke-dasharray="6 6" />
                <rect
                  x="120"
                  y="108"
                  width="64"
                  height="30"
                  rx="6"
                  fill="#ff7a01"
                  stroke-width="3"
                />
                <text
                  x="152"
                  y="128"
                  text-anchor="middle"
                  font-family="Poppins, sans-serif"
                  font-weight="900"
                  font-size="12"
                  fill="#111"
                  stroke="none"
                >
                  AP 301
                </text>
                <rect
                  x="194"
                  y="108"
                  width="42"
                  height="30"
                  rx="6"
                  fill="#ffd93d"
                  stroke-width="3"
                />
                <text
                  x="215"
                  y="128"
                  text-anchor="middle"
                  font-family="Poppins, sans-serif"
                  font-weight="900"
                  font-size="12"
                  fill="#111"
                  stroke="none"
                >
                  12A
                </text>
              </g>
            </g>
          </svg>
        </div>
      </section>

      <!-- Right -->
      <section class="ticket">
        <div class="ticket-head">
          <span>Boarding Pass</span>
          <span class="price">$1</span>
        </div>

        <form class="ticket-body" action="/checkout" method="POST">
          <div class="field">
            <label for="firstname">Full name</label>
            <input
              id="firstname"
              type="text"
              name="firstname"
              placeholder="Jane Doe"
              required
            />
          </div>

          <div class="row">
            <div class="field">
              <label for="email">Email</label>
              <input
                id="email"
                type="email"
                name="email"
                placeholder="you@email.com"
                required
              />
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input
                id="phone"
                type="text"
                name="phone"
                placeholder="(555) 123-4567"
                required
              />
            </div>
          </div>

          <hr class="divider" />

          <div class="field">
            <label for="flightnumber">Flight number</label>
            <input
              id="flightnumber"
              type="text"
              name="flightnumber"
              placeholder="AP 301"
              required
            />
          </div>

          <div class="row">
            <div class="field">
              <label for="airportodepart">From</label>
              <input
                id="airportodepart"
                type="text"
                name="airportodepart"
                placeholder="New York (JFK)"
                required
              />
            </div>
            <div class="field">
              <label for="airportoarrival">To</label>
              <input
                id="airportoarrival"
                type="text"
                name="airportoarrival"
                placeholder="Los Angeles (LAX)"
                required
              />
            </div>
          </div>

          <button class="btn-pay" type="submit">
            Pay $1 &amp; Get QR Code →
          </button>
          <p class="note">
            🔒 Secure payment by Stripe. Details can't be changed after payment.
          </p>
        </form>
      </section>
    </main>
  </body>
</html>

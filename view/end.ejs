<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>Payment Successful – AirPass</title>
    <meta
      name="description"
      content="Your payment was successful. Your AirPass QR code is on its way to your email."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ff7a01" />
    <meta name="color-scheme" content="light" />

    <!-- Favicon -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect x='4' y='4' width='56' height='56' rx='12' fill='%23ff7a01' stroke='%23111' stroke-width='5'/%3E%3Cpath d='M14 34 L50 22 L40 46 L33 37 Z' fill='%23fff' stroke='%23111' stroke-width='4' stroke-linejoin='round'/%3E%3C/svg%3E"
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink: #111;
        --paper: #ffeec9;
        --orange: #ff7a01;
        --yellow: #ffd93d;
        --green: #7ee081;
        --white: #fff;
        --border: 3px solid var(--ink);
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Poppins', sans-serif;
        color: var(--ink);
        background-color: var(--paper);
        background-image: radial-gradient(var(--ink) 1px, transparent 1px);
        background-size: 22px 22px;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px 16px;
      }

      .card {
        width: 100%;
        max-width: 460px;
        background: var(--white);
        border: var(--border);
        border-right-width: 6px;
        border-bottom-width: 6px;
        box-shadow: 10px 10px 0 var(--ink);
        border-radius: 16px;
        overflow: hidden;
      }

      .card-head {
        background: var(--orange);
        border-bottom: var(--border);
        padding: 14px 22px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 1px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .tag {
        background: var(--green);
        border: var(--border);
        border-radius: 8px;
        padding: 2px 12px;
        box-shadow: 3px 3px 0 var(--ink);
        font-size: 13px;
      }

      .card-body {
        padding: 28px 24px 30px;
        text-align: center;
      }

      .check {
        width: 96px;
        height: 96px;
        margin: 0 auto 20px;
        background: var(--green);
        border: var(--border);
        border-radius: 50%;
        box-shadow: 5px 5px 0 var(--ink);
        display: grid;
        place-items: center;
        transform: rotate(-6deg);
      }

      h1 {
        font-size: clamp(26px, 6vw, 34px);
        font-weight: 900;
        text-transform: uppercase;
        line-height: 1.1;
        margin-bottom: 12px;
      }
      h1 span {
        background: var(--yellow);
        border: var(--border);
        padding: 0 8px;
        display: inline-block;
        transform: rotate(-1.5deg);
      }

      .lead {
        font-weight: 500;
        line-height: 1.5;
        margin-bottom: 22px;
      }

      .steps {
        list-style: none;
        text-align: left;
        border: var(--border);
        border-radius: 12px;
        background: var(--paper);
        margin-bottom: 24px;
      }
      .steps li {
        padding: 12px 14px;
        font-weight: 600;
        font-size: 14px;
        display: flex;
        gap: 12px;
        align-items: center;
      }
      .steps li + li {
        border-top: 3px dashed var(--ink);
      }
      .num {
        flex: none;
        width: 28px;
        height: 28px;
        background: var(--orange);
        border: var(--border);
        border-radius: 50%;
        display: grid;
        place-items: center;
        font-weight: 900;
        font-size: 13px;
      }

      .btn {
        display: inline-block;
        text-decoration: none;
        color: var(--ink);
        font-weight: 900;
        font-size: 16px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 13px 30px;
        background: var(--orange);
        border: var(--border);
        border-radius: 12px;
        box-shadow: 6px 6px 0 var(--ink);
        transition:
          transform 0.1s ease,
          box-shadow 0.1s ease,
          background 0.1s ease;
      }
      .btn:hover {
        background: var(--yellow);
        transform: translate(-2px, -2px);
        box-shadow: 8px 8px 0 var(--ink);
      }
      .btn:active {
        transform: translate(6px, 6px);
        box-shadow: 0 0 0 var(--ink);
      }

      @media (max-width: 480px) {
        .card {
          box-shadow: 6px 6px 0 var(--ink);
        }
      }
    </style>
  </head>

  <body>
    <main class="card">
      <div class="card-head">
        <span>AirPass</span>
        <span class="tag">Paid ✔</span>
      </div>

      <div class="card-body">
        <div class="check">
          <svg
            viewBox="0 0 120 80"
            width="64"
            height="44"
            fill="none"
            stroke="#111"
            stroke-width="5"
            stroke-linejoin="round"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <polygon points="38,34 62,34 46,8 30,8" fill="#ffd93d" />
            <path
              d="M6 40Q6 26 22 26H84Q108 26 114 40Q108 54 84 54H22Q6 54 6 40Z"
              fill="#fff"
            />
            <polygon points="38,48 62,48 46,74 30,74" fill="#ffd93d" />
            <circle cx="94" cy="38" r="4" fill="#111" />
          </svg>
        </div>

        <h1>Thanks for your <span>purchase!</span></h1>
        <p class="lead">
          Your payment went through. Your QR code is being sent to your email
          right now.
        </p>

        <ul class="steps">
          <li>
            <span class="num">1</span> Open your inbox (arrives in a few
            seconds)
          </li>
          <li>
            <span class="num">2</span> Can't see it? Check your spam folder
          </li>
          <li>
            <span class="num">3</span> Save the QR code and show it at the
            airport
          </li>
        </ul>

        <a href="/" class="btn">← Back</a>
      </div>
    </main>
  </body>
</html>
